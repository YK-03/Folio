{
  "extends": ["next/core-web-vitals"],
  "rules": {
    /* ─── Imports ─── */
    "import/no-default-export": "off", // Next.js requires default exports for pages

    /* ─── TypeScript ─── */

    /* ─── General ─── */
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "prefer-const": "error"
  }
}
